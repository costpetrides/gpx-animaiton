{
  "name": "gpx-cinematic-renderer",
  "private": true,
  "version": "1.3.0",
  "description": "Cinematic GPX video rendering engine \u2014 upload a trail, preview the film, export MP4",
  "author": "GPX Cinematic Renderer",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "start": "node scripts/dev-app.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "validate:gpx": "node scripts/validate-gpx-suite.mjs",
    "test:mobile": "node --test src/mobile/ryodoMobileProfile.test.js"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "maplibre-gl": "^5.6.0",
    "mp4-muxer": "^5.2.2"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "linkedom": "^0.18.13",
    "playwright": "^1.54.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.gpx3drenderer.app",
    "productName": "GPX Cinematic Renderer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./mount": "./src/mountTrailRenderer.js",
    "./engine": "./src/engine/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "ARCHITECTURE.md",
    "index.html",
    "public",
    "electron"
  ]
}
